<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Cross-browser suite - the same regression scenarios against Chrome, Firefox and Edge at once.

  Run against the Dockerised Grid, which is where three browsers can exist on one machine:

      docker compose up -d
      mvn test -Dexecution=grid -Dsurefire.suiteXmlFiles=src/test/resources/suites/parallel-grid.xml

  -Dexecution=grid is required and is NOT set here. Execution target is a property, not a suite
  concern: the same file has to work against a local Docker grid, a CI grid and a cloud provider,
  and baking one of them in would quietly make the other two wrong.

  How the browser reaches the driver
  ----------------------------------
  Through BrowserParameterListener, not through the parameter alone. DriverFactory reads the
  browser from ConfigReader, which resolves a single JVM-wide -Dbrowser - a TestNG <parameter>
  never reaches it. Without that listener all three blocks below would run Chrome and the suite
  would report cross-browser coverage it never had. The listener reads each <test> block's
  parameter in beforeInvocation, on the thread about to run the scenario, and pins it there.
-->
<suite name="Cross-browser regression" verbose="1"
       parallel="tests" thread-count="3"
       data-provider-thread-count="6"
       configfailurepolicy="continue">

    <!--
      Two independent knobs, and both are needed:

        parallel="tests" thread-count="3"  - starts the three browser blocks at the same time.
                                             Without it TestNG finishes Chrome before starting
                                             Firefox and the run takes three times as long.
        data-provider-thread-count="6"     - the scenario-level pool, shared by all three blocks.
                                             This is the real cap on concurrent browser sessions.

      Six sessions is two per browser, which matches `docker compose up --scale chrome=2
      --scale firefox=2 --scale edge=2`. Raise it past the node count and scenarios queue at the
      hub rather than failing - slower, not broken - but the timeouts start to look like
      application slowness, which is a miserable thing to debug. Keep the two numbers in step.
    -->

    <test name="chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.adarsh.runners.RegressionRunner"/>
        </classes>
    </test>

    <test name="firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.adarsh.runners.RegressionRunner"/>
        </classes>
    </test>

    <test name="edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.adarsh.runners.RegressionRunner"/>
        </classes>
    </test>

    <!--
      The domain unit tests are not repeated here. They do not touch a browser, so running them
      three times proves nothing and only makes the report harder to read. testng-regression.xml
      owns them.

      Known limitation: the browser console log attached on failure is Chromium-only. The Firefox
      block still captures a screenshot, page source and URL - TestListener degrades each capture
      independently rather than losing the whole evidence bundle to one unsupported call.
    -->
</suite>
